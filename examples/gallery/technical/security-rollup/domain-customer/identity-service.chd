        "stroke": "#1d4ed8",
        "strokeWidth": 2,
        "fontColor": "#1e3a8a"
      },
      "data": {
        "label": "Auth DB\n(PostgreSQL)",
        "security": {
          "t-breach": {
            "probability": 3,
            "consequence": 5,
            "consequenceNote": "Full credential store — worst case is total account compromise."
          },
          "t-outage": {
            "probability": 2,
            "consequence": 4
          },
          "t-supply": {
            "probability": 2,
