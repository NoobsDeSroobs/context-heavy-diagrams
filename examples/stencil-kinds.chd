      },
      "data": {
        "label": "A step that is done again and again until something is met. Found by searching for loop or repeat."
      }
    },
    {
      "id": "kind-branch-exclusive",
      "type": "stencil",
      "position": {
        "x": 56,
        "y": 566
      },
      "size": {
        "width": 48,
        "height": 48
      },
      "data": {
        "label": "Decision",
        "kind": "branch-exclusive"
      }
    },
    {
      "id": "what-branch-exclusive",
      "type": "text",
      "position": {
        "x": 190,
        "y": 558
      },
      "size": {
        "width": 450,
        "height": 64
      },
      "style": {
        "fontSize": 12,
        "textAlign": "center"
      },
      "data": {
        "label": "A choice of one way on out of several. Name it with a question, such as \"In stock?\", and label the edges that leave it (\"yes\", \"no\"). Found by searching for gateway, xor or choice."
      }
    },
    {
      "id": "kind-branch-inclusive",
      "type": "stencil",
      "position": {
        "x": 56,
        "y": 662
      },
      "size": {
        "width": 48,
        "height": 48
      },
      "data": {
        "label": "Inclusive choice",
        "kind": "branch-inclusive"
      }
    },
    {
      "id": "what-branch-inclusive",
      "type": "text",
      "position": {
        "x": 190,
        "y": 654
      },
      "size": {
        "width": 450,
        "height": 64
      },
      "style": {
        "fontSize": 12,
        "textAlign": "center"
      },
      "data": {
        "label": "A choice of one or more ways on: every branch whose condition holds is taken. Found by searching for inclusive gateway or or."
      }
    },
    {
      "id": "kind-branch-parallel",
      "type": "stencil",
      "position": {
        "x": 56,
        "y": 758
      },
      "size": {
        "width": 48,
        "height": 48
      },
      "data": {
        "label": "Run in parallel",
        "kind": "branch-parallel"
      }
    },
    {
      "id": "what-branch-parallel",
      "type": "text",
      "position": {
        "x": 190,
        "y": 750
      },
      "size": {
        "width": 450,
        "height": 64
      },
      "style": {
        "fontSize": 12,
        "textAlign": "center"
      },
      "data": {
        "label": "Starts paths that all run at the same time. With several arrows in, it waits for every one of them, so it can close them too. Found by searching for fork, split, parallel or gateway."
      }
    },
    {
      "id": "kind-branch-all",
      "type": "stencil",
      "position": {
        "x": 56,
        "y": 854
      },
      "size": {
        "width": 48,
        "height": 48
      },
      "data": {
        "label": "Wait for all",
        "kind": "branch-all"
      }
    },
    {
      "id": "what-branch-all",
      "type": "text",
      "position": {
        "x": 190,
        "y": 846
      },
      "size": {
        "width": 450,
        "height": 64
      },
      "style": {
        "fontSize": 12,
        "textAlign": "center"
      },
      "data": {
        "label": "Closes parallel paths: the flow goes on once every path into it has arrived. Close the ways of a decision with a decision instead, or it waits for ways that are never taken. Found by searching for join, synchronise or wait for all."
      }
    },
    {
      "id": "kind-branch-one",
      "type": "stencil",
      "position": {
        "x": 56,
        "y": 950
      },
      "size": {
        "width": 48,
        "height": 48
      },
      "data": {
        "label": "Wait for first",
        "kind": "branch-one"
      }
    },
    {
      "id": "what-branch-one",
      "type": "text",
      "position": {
        "x": 190,
        "y": 942
      },
      "size": {
        "width": 450,
        "height": 64
      },
      "style": {
        "fontSize": 12,
        "textAlign": "center"
      },
      "data": {
        "label": "Closes parallel paths: the flow goes on with the first path to arrive. Found by searching for race, discriminator or any of."
      }
    },
    {
      "id": "kind-event-start",
