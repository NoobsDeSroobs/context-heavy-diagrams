      "position": {
        "x": 190,
        "y": 178
      },
      "size": {
        "width": 450,
        "height": 64
      },
      "style": {
        "fontSize": 12,
        "textAlign": "center"
      },
      "data": {
        "label": "A choice between ways on. Name it with a question, such as \"In stock?\", and label the edges that leave it (\"yes\", \"no\"). Found by searching for gateway, xor or choice."
      }
    },
