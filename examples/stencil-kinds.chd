    {
      "id": "what-event-start",
      "type": "text",
      "position": {
        "x": 190,
        "y": 1038
      },
      "size": {
        "width": 450,
        "height": 64
      },
      "style": {
        "fontSize": 12,
        "textAlign": "center"
      },
      "data": {
        "label": "Where a flow begins when it is not known or does not matter what sets it going. A flow can have more than one start; a timer, message or human action with nothing leading into it begins one too."
      }
    },
