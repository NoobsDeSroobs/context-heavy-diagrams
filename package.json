{
  "name": "context-heavy-diagrams",
  "version": "0.2.1",
  "description": "Offline desktop diagramming: git-friendly plain-text diagrams, drill-down linked diagrams, and per-node notes and tags. Early open-source release.",
  "main": "./out/main/index.js",
  "license": "GPL-3.0-or-later",
  "author": "Magnus Elden",
  "homepage": "https://github.com/NoobsDeSroobs/context-heavy-diagrams#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NoobsDeSroobs/context-heavy-diagrams.git"
  },
  "bugs": {
    "url": "https://github.com/NoobsDeSroobs/context-heavy-diagrams/issues"
  },
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "node --test \"src/**/*.test.mjs\" \"extension/**/*.test.mjs\"",
    "sync-ai": "node scripts/sync-ai.mjs",
    "notices": "node scripts/generate-notices.mjs",
    "icons": "electron scripts/make-icons.mjs",
    "build:extension": "node scripts/build-extension.mjs",
    "build:cli": "node scripts/build-cli.mjs",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && npm run build:extension && npm run build:cli && electron-vite build",
    "postinstall": "install-electron && electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@tabler/icons": "^3.46.0",
    "@xyflow/react": "^12.11.3",
    "html-to-image": "^1.11.13",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "^2.1.2",
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "^43.4.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "prettier": "^3.7.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.6"
  },
  "allowScripts": {
    "electron-winstaller": false,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "fsevents": false
  }
}
